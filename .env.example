# Supabase Project URL from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (sb_publishable_...). Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only speech-to-text configuration. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
SPEECH_TO_TEXT_PROVIDER=openai
