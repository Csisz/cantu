# Supabase Project URL from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (sb_publishable_...). Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret (sb_secret_... or local service-role key) for the
# validated analysis-result write boundary. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Server-only speech-to-text configuration. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
SPEECH_TO_TEXT_PROVIDER=openai

# Server-only structured language-analysis configuration.
LANGUAGE_ANALYSIS_PROVIDER=openai
LANGUAGE_ANALYSIS_MODEL=gpt-5.6-terra

# Server-only bounded Real-Life Practice Lab configuration.
CONVERSATION_PRACTICE_PROVIDER=openai
CONVERSATION_PRACTICE_MODEL=gpt-5.6-terra
