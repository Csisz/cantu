# Supabase Project URL from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (sb_publishable_...). Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret (sb_secret_... or local service-role key) for the
# validated analysis-result write boundary. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Server-only HMAC secret for short-lived Practice Lab state. Use at least 32 random characters.
PRACTICE_STATE_SECRET=

# Server-only speech-to-text configuration. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
SPEECH_TO_TEXT_PROVIDER=openai

# Server-only structured language-analysis configuration.
LANGUAGE_ANALYSIS_PROVIDER=openai
LANGUAGE_ANALYSIS_MODEL=gpt-5.6-terra

# Server-only bounded Real-Life Practice Lab configuration.
CONVERSATION_PRACTICE_PROVIDER=openai
CONVERSATION_PRACTICE_MODEL=gpt-5.6-terra

# Public deployment configuration. Contact must be finalized before beta launch.
APP_ORIGIN=http://localhost:3000
PUBLIC_CONTACT_EMAIL=[CONTACT_EMAIL_REQUIRED]

# Billing is explicitly disabled until test/live mode is selected. All Stripe
# credentials are server-only. Never expose them through NEXT_PUBLIC_ variables.
CANTU_BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CANTU_PLUS=
CANTU_PLUS_PRICE_LABEL=

# Optional emergency cost controls. Local input, saved lessons and review remain available.
CANTU_DISABLE_TRANSCRIPTION=false
CANTU_DISABLE_ANALYSIS=false
CANTU_DISABLE_PRONUNCIATION=false
CANTU_DISABLE_PRACTICE=false
